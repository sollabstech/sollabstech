rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public clients — anyone can read published ones; only admins can write
    match /clients/{clientId} {
      allow read: if resource.data.published == true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Private client data — admin only, never public
    match /clientsPrivate/{clientId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Products — public reads; admin writes only
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;

      // IMEI and private product data — admin only
      match /private/{doc} {
        allow read, write: if request.auth != null && request.auth.token.admin == true;
      }
    }

    // Contact messages — anyone can create; admin can read
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
